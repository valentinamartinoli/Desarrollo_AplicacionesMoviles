<?xml version="1.0" encoding="utf-8"?>
<!-- Logo de Maderita: una "M" de madera dentro de un círculo verde pálido -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Círculo de fondo con borde verde -->
    <path
        android:fillColor="#C2CFB0"
        android:pathData="M54,54m-46,0a46,46 0,1 1,92 0a46,46 0,1 1,-92 0"
        android:strokeColor="#7EAA6E"
        android:strokeWidth="6" />

    <!-- Anillo fino interior, como los anillos de un tronco -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0"
        android:strokeColor="#F0F1E5"
        android:strokeWidth="2" />

    <!-- Letra M -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,75L31,34L54,58L77,34L77,75"
        android:strokeColor="#6B4423"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>